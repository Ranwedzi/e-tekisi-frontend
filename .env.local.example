# Copy to .env.local and change for staging/production.

# Backend origin.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Map tiles. The OpenStreetMap default is for development and light use only;
# use a tile provider (with its API key in the URL) for production traffic.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
